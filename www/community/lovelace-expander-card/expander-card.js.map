{
    "name": "lovelace-expander-card",
    "version": "7.3.7",
    "type": "module",
    "watch": {
        "buildAndStart": {
            "patterns": [
                "src"
            ],
            "extensions": "svelte"
        }
    },
    "scripts": {
        "build": "eslint . && vite build",
        "srv": "pnpx serve -l 5000 --cors dist",
        "lint": "eslint .",
        "lint-fix": "eslint . --fix"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@sveltejs/adapter-node": "^6.0.1",
        "@sveltejs/enhanced-img": "^1.0.0",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@types/eslint": "9.6.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "postcss-preset-env": "^11.6.2",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "5.57.3",
        "svelte-check": "^4.7.7",
        "svelte-eslint-parser": "^1.10.0",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.72.1",
        "vite": "^8.3.5"
    },
    "dependencies": {
        "home-assistant-javascript-templates": "^8.0.0",
        "home-assistant-query-selector": "^7.0.0",
        "lit": "^3.3.3",
        "svelte": "5.57.3"
    },
    "pnpm": {
        "ignoredBuiltDependencies": [
            "@sveltejs/kit"
        ]
    }
}
